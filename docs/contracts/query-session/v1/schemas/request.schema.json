{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory:local-query-session:request:v1",
  "title": "Turn-local query with compact progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "status",
        "recall",
        "sources",
        "navigate",
        "events"
      ]
    },
    "parameters": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "status"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "recall"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          },
          "required": [
            "query"
          ]
        }
      },
      "required": [
        "parameters"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "sources"
        },
        "parameters": {
          "description": "Canonical local tool arguments. Host resolves identity. Runtime validates dates, ranges, cursors and budgets.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "search",
                "range",
                "context",
                "read"
              ],
              "default": "search"
            },
            "terms": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              }
            },
            "start_at": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))$"
            },
            "end_at": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))$"
            },
            "source_ref": {
              "type": "string",
              "maxLength": 180,
              "pattern": "^(?:|timeline:tl_.+)$"
            },
            "direction": {
              "type": "string",
              "enum": [
                "around",
                "before",
                "after"
              ],
              "default": "around"
            },
            "excerpt_offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "cursor": {
              "type": "string",
              "maxLength": 160,
              "default": ""
            },
            "limit": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "0 uses the configured default; positive values are clamped to at most 12."
            }
          },
          "oneOf": [
            {
              "properties": {
                "cursor": {
                  "const": ""
                }
              },
              "anyOf": [
                {
                  "required": [
                    "terms"
                  ],
                  "properties": {
                    "action": {
                      "const": "search"
                    },
                    "terms": {
                      "type": "array",
                      "minItems": 1
                    },
                    "source_ref": {
                      "const": ""
                    },
                    "direction": {
                      "const": "around"
                    },
                    "excerpt_offset": {
                      "const": 0
                    }
                  }
                },
                {
                  "required": [
                    "action",
                    "start_at",
                    "end_at"
                  ],
                  "properties": {
                    "action": {
                      "const": "range"
                    },
                    "terms": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "maxItems": 0
                        }
                      ]
                    },
                    "start_at": {
                      "minLength": 1
                    },
                    "end_at": {
                      "minLength": 1
                    },
                    "source_ref": {
                      "const": ""
                    },
                    "direction": {
                      "const": "around"
                    },
                    "excerpt_offset": {
                      "const": 0
                    }
                  }
                },
                {
                  "required": [
                    "action",
                    "source_ref"
                  ],
                  "properties": {
                    "action": {
                      "const": "context"
                    },
                    "terms": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "maxItems": 0
                        }
                      ]
                    },
                    "start_at": {
                      "const": ""
                    },
                    "end_at": {
                      "const": ""
                    },
                    "source_ref": {
                      "minLength": 13
                    },
                    "excerpt_offset": {
                      "const": 0
                    }
                  }
                },
                {
                  "required": [
                    "action",
                    "source_ref"
                  ],
                  "properties": {
                    "action": {
                      "const": "read"
                    },
                    "terms": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "maxItems": 0
                        }
                      ]
                    },
                    "start_at": {
                      "const": ""
                    },
                    "end_at": {
                      "const": ""
                    },
                    "source_ref": {
                      "minLength": 13
                    },
                    "direction": {
                      "const": "around"
                    }
                  }
                }
              ]
            },
            {
              "required": [
                "cursor"
              ],
              "properties": {
                "cursor": {
                  "type": "string",
                  "pattern": "^src_[A-Za-z0-9_-]+$",
                  "maxLength": 160
                },
                "action": {
                  "const": "search"
                },
                "terms": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "maxItems": 0
                    }
                  ]
                },
                "start_at": {
                  "const": ""
                },
                "end_at": {
                  "const": ""
                },
                "source_ref": {
                  "const": ""
                },
                "direction": {
                  "const": "around"
                },
                "excerpt_offset": {
                  "const": 0
                },
                "limit": {
                  "const": 0
                }
              }
            }
          ]
        }
      },
      "required": [
        "parameters"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "navigate"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "search",
                "event_time",
                "event_context",
                "tag_events",
                "person_aspect",
                "topic_events",
                "reverse_cues"
              ]
            },
            "query": {
              "type": "string",
              "maxLength": 1000
            },
            "cue": {
              "type": "string",
              "maxLength": 160
            },
            "tag": {
              "type": "string",
              "maxLength": 80
            },
            "memory_ids": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "node_type": {
              "type": "string",
              "maxLength": 40
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "action"
          ]
        }
      },
      "required": [
        "parameters"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "events"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan"
          ],
          "properties": {
            "plan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "goal",
                "unit",
                "operation",
                "timezone",
                "select",
                "rows"
              ],
              "properties": {
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "list",
                    "count",
                    "latest",
                    "earliest",
                    "by_day"
                  ]
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "IANA 时区，例如 Asia/Shanghai，运行时校验。"
                },
                "window": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start_at",
                        "end_at"
                      ],
                      "properties": {
                        "start_at": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                        },
                        "end_at": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "subject",
                    "world",
                    "occurrences"
                  ],
                  "properties": {
                    "subject": {
                      "type": "string",
                      "enum": [
                        "current_user",
                        "assistant",
                        "other",
                        "any"
                      ]
                    },
                    "world": {
                      "type": "string",
                      "enum": [
                        "real",
                        "fictional",
                        "any"
                      ]
                    },
                    "occurrences": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "string",
                        "enum": [
                          "occurred",
                          "not_occurred",
                          "planned",
                          "cancelled"
                        ]
                      }
                    }
                  }
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 48,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "row_id",
                      "event_key",
                      "description",
                      "subject",
                      "world",
                      "occurrence",
                      "relevance",
                      "identity",
                      "resolution",
                      "time",
                      "evidence"
                    ],
                    "properties": {
                      "row_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "event_key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "description": "当前计划内的事件身份；仅确定同一事件才复用。"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "subject": {
                        "type": "string",
                        "enum": [
                          "current_user",
                          "assistant",
                          "other",
                          "unknown"
                        ]
                      },
                      "world": {
                        "type": "string",
                        "enum": [
                          "real",
                          "fictional",
                          "unknown"
                        ]
                      },
                      "occurrence": {
                        "type": "string",
                        "enum": [
                          "occurred",
                          "not_occurred",
                          "planned",
                          "cancelled",
                          "unknown"
                        ]
                      },
                      "relevance": {
                        "type": "string",
                        "enum": [
                          "match",
                          "not_match",
                          "uncertain"
                        ]
                      },
                      "identity": {
                        "type": "string",
                        "enum": [
                          "clear",
                          "uncertain"
                        ]
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "resolved",
                          "uncertain",
                          "conflicting"
                        ]
                      },
                      "time": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "unknown"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "date",
                              "timezone",
                              "source_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "date"
                              },
                              "date": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                              },
                              "timezone": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80,
                                "description": "IANA 时区，例如 Asia/Shanghai，运行时校验。"
                              },
                              "source_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 180,
                                "pattern": "^timeline:tl_.+$"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "source_ref",
                              "days",
                              "timezone"
                            ],
                            "properties": {
                              "kind": {
                                "const": "relative_day"
                              },
                              "source_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 180,
                                "pattern": "^timeline:tl_.+$"
                              },
                              "days": {
                                "type": "integer",
                                "minimum": -36600,
                                "maximum": 36600
                              },
                              "timezone": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80,
                                "description": "IANA 时区，例如 Asia/Shanghai，运行时校验。"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "at",
                              "source_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "instant"
                              },
                              "at": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80,
                                "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                              },
                              "source_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 180,
                                "pattern": "^timeline:tl_.+$"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "start_at",
                              "end_at",
                              "source_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "interval"
                              },
                              "start_at": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80,
                                "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                              },
                              "end_at": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80,
                                "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                              },
                              "source_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 180,
                                "pattern": "^timeline:tl_.+$"
                              }
                            }
                          }
                        ]
                      },
                      "evidence": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source_ref",
                            "source_version",
                            "quote"
                          ],
                          "properties": {
                            "source_ref": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 180,
                              "pattern": "^timeline:tl_.+$"
                            },
                            "source_version": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 800,
                              "description": "逐字引用本轮已读 sources 的脱敏片段。"
                            }
                          }
                        }
                      },
                      "supersedes": {
                        "type": "array",
                        "maxItems": 48,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "description": "本计划内同一事件被明确纠正的 row_id，不修改事实库。"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "by_day"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "window"
                    ],
                    "properties": {
                      "window": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start_at",
                          "end_at"
                        ],
                        "properties": {
                          "start_at": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                          },
                          "end_at": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "parameters"
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory:local-source-query:request:v2",
  "title": "Authorized chronological range batch arguments",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {"enum": ["search", "range_batch"], "default": "search"},
    "start_at": {"type": "string", "maxLength": 80, "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))$"},
    "end_at": {"type": "string", "maxLength": 80, "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))$"},
    "cursor": {"type": "string", "maxLength": 160, "default": ""},
    "terms": {"enum": [null, []]},
    "source_ref": {"const": ""},
    "direction": {"const": "around"},
    "excerpt_offset": {"const": 0, "type": "integer"},
    "limit": {"const": 0, "type": "integer", "description": "Batch limits are bound by the service, not by the caller."}
  },
  "oneOf": [
    {
      "required": ["action", "start_at", "end_at"],
      "properties": {
        "action": {"const": "range_batch"}, "cursor": {"const": ""},
        "start_at": {"minLength": 1}, "end_at": {"minLength": 1}
      }
    },
    {
      "required": ["cursor"],
      "properties": {
        "action": {"const": "search"}, "cursor": {"pattern": "^srcb_[A-Za-z0-9_-]+$"},
        "start_at": {"const": ""}, "end_at": {"const": ""}
      }
    }
  ]
}

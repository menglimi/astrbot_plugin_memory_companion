{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory:local-source-query:result:v2",
  "title": "Chronological stored source batch result",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "ok", "status", "error", "sources", "batch", "coverage", "usage"],
  "properties": {
    "profile": {"const": "memory.local-source-query.v2"},
    "ok": {"type": "boolean"},
    "status": {"enum": ["batch", "partial", "empty", "rejected"]},
    "error": {"type": "string"},
    "sources": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/source"}},
    "query": {
      "type": "object", "additionalProperties": false, "required": ["action", "start_at", "end_at"],
      "properties": {"action": {"const": "range_batch"}, "start_at": {"$ref": "#/$defs/instant"}, "end_at": {"$ref": "#/$defs/instant"}}
    },
    "batch": {"type": "object"}, "coverage": {"type": "object"}, "usage": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {
        "required": ["query"],
        "properties": {
          "status": {"enum": ["batch", "partial", "empty"]}, "error": {"const": ""},
          "batch": {"$ref": "#/$defs/batch"}, "coverage": {"$ref": "#/$defs/coverage"}, "usage": {"$ref": "#/$defs/usage"}
        }
      },
      "else": {
        "not": {"required": ["query"]},
        "properties": {"status": {"const": "rejected"}, "error": {"minLength": 1}, "sources": {"maxItems": 0}, "batch": {"maxProperties": 0}, "coverage": {"maxProperties": 0}, "usage": {"maxProperties": 0}}
      }
    },
    {"if": {"properties": {"status": {"const": "batch"}}}, "then": {"properties": {"ok": {"const": true}, "sources": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "empty"}}}, "then": {"properties": {"ok": {"const": true}, "sources": {"maxItems": 0}}}},
    {
      "if": {"properties": {"ok": {"const": true}, "coverage": {"properties": {"presentation": {"properties": {"status": {"const": "complete"}}}}}}},
      "then": {"properties": {"batch": {"properties": {"next_batch_cursor": {"const": null}}}, "coverage": {"properties": {"traversal": {"properties": {"eof": {"const": true}}}, "presentation": {"properties": {"pending_excerpt": {"const": false}, "cumulative_suppressed_messages": {"const": 0}}}}}}}
    }
  ],
  "$defs": {
    "instant": {"type": "string", "maxLength": 80, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "count": {"type": "integer", "minimum": 0},
    "ref": {"type": ["string", "null"], "pattern": "^timeline:tl_.+$", "maxLength": 180},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "source_version", "source_kind", "speaker_role", "speaker_id", "message_at", "message_at_local", "recorded_at", "time_basis", "excerpt", "excerpt_offset", "excerpt_end", "next_excerpt_offset", "excerpt_truncated", "capture_truncated"],
      "properties": {
        "source_ref": {"type": "string", "pattern": "^timeline:tl_.+$", "maxLength": 180},
        "source_version": {"type": "string", "minLength": 1}, "source_kind": {"const": "stored_message"},
        "speaker_role": {"enum": ["user", "assistant"]}, "speaker_id": {"type": "string", "maxLength": 120},
        "message_at": {"$ref": "#/$defs/instant"}, "message_at_local": {"type": "string"}, "recorded_at": {"type": "string", "maxLength": 80},
        "time_basis": {"const": "timeline_observation_not_event_occurrence"},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 800},
        "excerpt_offset": {"$ref": "#/$defs/count"}, "excerpt_end": {"$ref": "#/$defs/count"},
        "next_excerpt_offset": {"type": ["integer", "null"], "minimum": 0}, "excerpt_truncated": {"type": "boolean"}, "capture_truncated": {"type": ["boolean", "null"]}
      }
    },
    "batch": {
      "type": "object", "additionalProperties": false, "required": ["batch_id", "work_id", "sequence", "stop_reason", "next_batch_cursor", "expires_at"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^sbb_[a-f0-9]{16}$"}, "work_id": {"type": "string", "pattern": "^sbw_[a-f0-9]{16}$"},
        "sequence": {"type": "integer", "minimum": 1}, "stop_reason": {"enum": ["eof", "byte_budget", "message_budget", "fragment_budget"]},
        "next_batch_cursor": {"type": ["string", "null"], "pattern": "^srcb_[A-Za-z0-9_-]+$", "maxLength": 160}, "expires_at": {"$ref": "#/$defs/instant"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["traversal", "presentation", "interpretation", "dependencies"],
      "properties": {
        "traversal": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "time_basis", "interval", "order", "eof", "processed_messages", "cumulative_messages", "first_source_ref", "last_source_ref", "unknown_message_time"],
          "properties": {
            "scope": {"const": "current_session_only"}, "time_basis": {"const": "message_observation"}, "interval": {"const": "[start,end)"}, "order": {"const": "message_time_asc"},
            "eof": {"type": "boolean"}, "processed_messages": {"$ref": "#/$defs/count"}, "cumulative_messages": {"$ref": "#/$defs/count"},
            "first_source_ref": {"$ref": "#/$defs/ref"}, "last_source_ref": {"$ref": "#/$defs/ref"}, "unknown_message_time": {"const": "excluded_from_time_order"}
          }
        },
        "presentation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "returned_messages", "returned_fragments", "suppressed_messages", "cumulative_completed_messages", "cumulative_fragments", "cumulative_chars", "cumulative_suppressed_messages", "pending_excerpt"],
          "properties": {
            "status": {"enum": ["complete", "incomplete"]}, "returned_messages": {"$ref": "#/$defs/count"}, "returned_fragments": {"$ref": "#/$defs/count"}, "suppressed_messages": {"$ref": "#/$defs/count"},
            "cumulative_completed_messages": {"$ref": "#/$defs/count"}, "cumulative_fragments": {"$ref": "#/$defs/count"}, "cumulative_chars": {"$ref": "#/$defs/count"},
            "cumulative_suppressed_messages": {"$ref": "#/$defs/count"}, "pending_excerpt": {"type": "boolean"}
          }
        },
        "interpretation": {
          "type": "object", "additionalProperties": false, "required": ["event_coverage", "current_context", "capture_coverage"],
          "properties": {"event_coverage": {"const": "not_established"}, "current_context": {"const": "unknown"}, "capture_coverage": {"const": "not_established"}}
        },
        "dependencies": {
          "type": "object", "additionalProperties": false, "required": ["validity_mode", "source_revision", "policy_revision"],
          "properties": {"validity_mode": {"const": "global"}, "source_revision": {"type": "string", "pattern": "^[0-9]+$"}, "policy_revision": {"type": "string", "pattern": "^[0-9]+$"}}
        }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["step", "remaining_steps", "model_calls", "read_count", "returned_chars", "returned_bytes", "elapsed_ms", "limits", "host_context_budget"],
      "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 8}, "remaining_steps": {"$ref": "#/$defs/count"}, "model_calls": {"const": 0},
        "read_count": {"$ref": "#/$defs/count"}, "returned_chars": {"$ref": "#/$defs/count"}, "returned_bytes": {"$ref": "#/$defs/count"}, "elapsed_ms": {"$ref": "#/$defs/count"}, "host_context_budget": {"const": "unknown"},
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["max_bytes", "max_messages", "max_fragments", "excerpt_chars"],
          "properties": {"max_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}, "max_messages": {"type": "integer", "minimum": 1, "maximum": 256}, "max_fragments": {"type": "integer", "minimum": 1, "maximum": 256}, "excerpt_chars": {"type": "integer", "minimum": 1, "maximum": 800}}
        }
      }
    }
  }
}

                  "unresolved",
                  "interval_partial_order"
                ]
              },
              "by_day": {
                "type": "array",
                "maxItems": 48,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "event_keys",
                    "count",
                    "by_occurrence"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "event_keys": {
                      "type": "array",
                      "maxItems": 48,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "by_occurrence": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "occurred": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "not_occurred": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "planned": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "cancelled": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              },
              "unplaced_event_keys": {
                "type": "array",
                "maxItems": 48,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "days_without_resolved_events": {
                "type": "array",
                "maxItems": 31,
                "items": {
                  "type": "string"
                }
              },
              "day_grid": {
                "type": "string",
                "enum": [
                  "not_requested",
                  "enumerated",
                  "omitted_over_31_days"
                ]
              },
              "absence_meaning": {
                "const": "no_resolved_event_in_supplied_rows_not_proof_of_no_event"
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "event_window",
              "source_revision",
              "event_coverage",
              "semantics",
              "citations",
              "input_rows",
              "cited_source_count",
              "observed_uncited_source_count",
              "source_reads",
              "not_checked"
            ],
            "properties": {
              "scope": {
                "const": "current_session_only"
              },
              "event_window": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start_at",
                      "end_at"
                    ],
                    "properties": {
                      "start_at": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                      },
                      "end_at": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "description": "带时区 ISO 8601，运行时校验真实日期与顺序。",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "event_coverage": {
                "const": "not_established"
              },
              "semantics": {
                "const": "model_interpretation_not_verified_by_program"
              },
              "citations": {
                "const": "observed_fragments_revalidated"
              },
              "input_rows": {
                "type": "integer",
                "minimum": 0
              },
              "cited_source_count": {
                "type": "integer",
                "minimum": 0
              },
              "observed_uncited_source_count": {
                "type": "integer",
                "minimum": 0
              },
              "source_reads": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "selection",
                    "source_revision",
                    "start_at",
                    "end_at",
                    "more_available",
                    "returned_count",
                    "excerpt_truncated_count"
                  ],
                  "properties": {
                    "selection": {
                      "type": "string",
                      "enum": [
                        "literal_terms_any",
                        "range",
                        "context",
                        "read",
                        "navigation_references"
                      ]
                    },
                    "source_revision": {

  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "operation",
          "goal",
          "select"
        ],
        "properties": {
          "status": {
            "const": "computed"
          },
          "error": {
            "const": ""
          },
          "aggregate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "count_basis",
              "count",
              "by_occurrence",
              "latest_candidates",
              "earliest_candidates",
              "ordering",
              "by_day",
              "unplaced_event_keys",
              "days_without_resolved_events",
              "day_grid",
              "absence_meaning"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "count_basis": {
                "const": "model_resolved_event_groups_in_supplied_rows"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "by_occurrence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "occurred": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_occurred": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "planned": {
